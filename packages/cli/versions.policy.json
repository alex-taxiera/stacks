{
  "node": {
    "major": "24",
    "reason": "Node 26 became LTS in October 2026; every machine and existing repo is still on 24."
  },
  "minReleaseAgeDays": 3,
  "packages": {
    "@types/node": {
      "trackNode": true,
      "reason": "Types for the Node major in .nvmrc, not the newest Node."
    }
  },
  "groups": {
    "react": [
      "react",
      "react-dom",
      "@types/react",
      "@types/react-dom",
      "babel-plugin-react-compiler",
      "zustand"
    ],
    "chakra": [
      "@chakra-ui/*",
      "@emotion/*",
      "next-themes",
      "react-icons",
      "@fontsource-variable/*"
    ],
    "storybook": ["storybook", "@storybook/*"],
    "vite": [
      "vite",
      "@vitejs/*",
      "@rolldown/*",
      "vitest",
      "@vitest/*",
      "playwright",
      "vite-prerender-plugin",
      "@playwright/test"
    ],
    "tanstack": ["@tanstack/*", "nitro"],
    "oxc": ["oxlint", "oxfmt"],
    "typescript": ["typescript", "@types/node"],
    "tooling": ["husky", "lint-staged"],
    "sentry": ["@sentry/*"],
    "cloudflare": ["wrangler"],
    "tauri": ["@tauri-apps/*"],
    "server": ["better-auth", "drizzle-orm", "drizzle-kit", "pg", "@types/pg", "zod", "dotenv-cli"]
  },
  "images": {
    "postgres": {
      "tag": "^(\\d+)-alpine$",
      "reason": "The newest major; Dependabot moves the patch."
    },
    "traefik": {
      "tag": "^v(\\d+)\\.(\\d+)$"
    }
  }
}
