{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "__APP_TITLE__",
  "version": "0.1.0",
  "identifier": "__APP_IDENTIFIER__",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:__DEV_PORT__",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "__APP_TITLE__",
        "width": 1100,
        "height": 720,
        "minWidth": 720,
        "minHeight": 480,
        "create": false
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
