---
// The desktop app's latest release, asked of GitHub as the site is built, so the page shows its
// downloads at once; the island asks again in the browser. A build that can't reach GitHub, or
// finds no release yet, still succeeds. CI passes GITHUB_TOKEN for a higher rate limit.
import { Downloads } from "#/components/Downloads";
import { fetchLatestRelease } from "#/downloads/github";
import Base from "#/layouts/Base.astro";
import { DESKTOP_APP } from "#/site-config";

const built = await fetchLatestRelease({ token: process.env.GITHUB_TOKEN }).catch(
  (error: unknown) => {
    console.warn(`Building the download page without a release: ${String(error)}`);
    return null;
  },
);
---

<Base title="Download" description={`Download ${DESKTOP_APP.title} for Windows, macOS and Linux.`}>
  <Downloads client:load built={built} />
</Base>
