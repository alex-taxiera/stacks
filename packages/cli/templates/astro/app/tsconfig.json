{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "types": ["node"],
    "paths": {
      "#/*": ["./src/*"]
    }
  },
  "contentMappers": [{ "package": "@astrojs/ts-content-mapper", "extensions": [".astro"] }],
  "include": [
    ".astro/types.d.ts",
    "src",
    ".storybook",
    "astro.config.ts",
    "vite.config.ts",
    "vitest.shims.d.ts"
  ],
  "exclude": ["dist"]
}
