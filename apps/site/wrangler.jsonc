{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Worker names are per account, so this one says whose site it is.
  "name": "stacks-site",
  "compatibility_date": "2026-11-17",
  "observability": { "enabled": true },
  // Served at stacks.taxiera.net. Cloudflare makes the DNS record and certificate on deploy; the
  // taxiera.net zone must be on the same account. workers.dev stays on for pull request previews.
  "routes": [{ "pattern": "stacks.taxiera.net", "custom_domain": true }],
  // The built pages, served as static assets.
  "assets": {
    "directory": "dist",
    // Astro's 404 page, with a 404 status, for a path no page has.
    "not_found_handling": "404-page",
  },
}
